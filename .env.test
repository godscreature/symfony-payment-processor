# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='change_me_in_env_local'

# Tests use their own Redis database (1), so they never touch dev data in database 0.
REDIS_URL=redis://redis:6379/1
LOCK_DSN=redis://redis:6379/1

# The test client connects from 127.0.0.1; tests treat it as the load balancer.
TRUSTED_PROXIES=127.0.0.1
